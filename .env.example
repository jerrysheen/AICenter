AI_CENTER_HOST=0.0.0.0
# Launcher 未显式传 -Port 时，同样遵循 Process → Instance .env → Repository .env → 8787。
AI_CENTER_PORT=8787
# 单实例默认继续使用仓库内旧布局。设置 INSTANCE_DIR 后，默认改用该目录下的
# data / knowledge / config / imports / runtime；字段级旧变量仍可单独覆盖。
AI_CENTER_INSTANCE_ID=local
AI_CENTER_INSTANCE_DIR=
AI_CENTER_DATA_DIR=
AI_CENTER_KNOWLEDGE_DIR=
AI_CENTER_PAIRING_TTL_MINUTES=10
# 可选：实例共享账号，作为扫码配对之外的登录入口。两者都填才启用。
# 只写入未提交的 .env，不要提交真实密码。登录后仍签发设备 token，不会变成桌面管理员。
# AI_CENTER_LOGIN_USERNAME=
# AI_CENTER_LOGIN_PASSWORD=
AI_CENTER_WORKER_POLL_MS=1000
AI_CENTER_WORKER_LEASE_MS=600000

# 可选公网 HTTPS 入口。只有完成 docs/public-access-security.md 的 Tunnel 配置后再填写。
AI_CENTER_PUBLIC_URL=
AI_CENTER_PUBLIC_PAIRING_TTL_MINUTES=2

# 旧仓适配器只从环境读取位置，不在代码里写死机器路径。
AI_CENTER_SKILLS_ROOT=

# 浏览器采集。仓库随附 Windows CLI：externaltools/bsk.exe；也可显式配置其他路径。启动器会拉起 bsk daemon。
# AI_BROWSER_PROVIDER=bsk
# AI_BSK_PATH=externaltools/bsk.exe
AI_CENTER_BROWSER_ID=

# 沪深 / 港股通 / B 股现价优先雪球匿名行情；可选登录 Cookie 只写入未提交的 .env。
# 不要把 Cookie 提交进 Git，也不要配给手机端。
XUEQIU_COOKIE=
# 同花顺金融 API（Hithink / fuyao）仅作雪球缺票回退。未配置时再回退 Yahoo。
# 与 AI-Hub 相同：HITHINK_FINANCE_API_KEY。
HITHINK_FINANCE_API_KEY=
# 默认 https://fuyao.aicubes.cn ；本机代理可改 AI_CENTER_FINANCE_BASE_URL。
AI_CENTER_FINANCE_BASE_URL=

# Tushare Pro。网站登录后在个人中心复制 Token，不是账号密码。真实 token 只写入未提交的 .env。
TUSHARE_TOKEN=

# Elucid 专用 Grok Key（仅 Codex：启动-Codex-Grok.bat / .codex-grok）。
# 信息流翻译、Gemini、Google Translate、DeepL 都不会读取。
ELUCID_GROK_API_KEY=
# Codex 模型 grok-4.6，入口 https://hk.getelucid.com/v1

# Google AI Studio Gemini（信息流翻译专用）。
# 在 https://aistudio.google.com/apikey 创建 Key，按官方 JS 文档写入 GEMINI_API_KEY。
# https://aistudio.google.com/docs/get-started?codelanguage=javascript
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# AI_CENTER_GEMINI_MODEL=gemini-3.1-flash-lite

# Agent 问答。未填写专用 Key 时安全回退到 GEMINI_API_KEY；真实值仅写入未提交的 .env。
# 默认检测到 ELUCID_GROK_API_KEY 时使用 Elucid Grok；设为 gemini 可强制切回 Gemini。
AI_CENTER_AGENT_PROVIDER=elucid-grok
AI_CENTER_AGENT_API_KEY=
# AI_CENTER_AGENT_MODEL=gemini-3.1-flash-lite
# AI_CENTER_ELUCID_GROK_MODEL=grok-4.6
# 问答「专业研究」档位的更高模型。未配置时仍用上面的默认模型，只留接口。
# AI_CENTER_AGENT_RESEARCH_MODEL=
# AI_CENTER_ELUCID_GROK_RESEARCH_MODEL=
# AI_CENTER_ELUCID_GROK_API_ROOT=https://hk.getelucid.com/v1
# 非流式 Responses 会等待模型完整返回；默认 90 秒，最大 180 秒。
# AI_CENTER_ELUCID_GROK_TIMEOUT_MS=90000

# DeepSeek Native Search。search.web 的默认 Provider，复用官方 Anthropic-compatible Messages + web_search_20250305。
# 真实值只写入未提交的 .env。缺 Key 时不注册 search.web，不回退 SearXNG。
DEEPSEEK_API_KEY=
# DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1
# DEEPSEEK_SEARCH_MODEL=deepseek-v4-flash

# DeepL 免费 API。Gemini 未配置或失败时使用；再失败回退 Google 公开翻译接口（可能 429）。
AI_CENTER_DEEPL_API_KEY=
# AI_CENTER_DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# 个人资产分析工作簿。默认读取当前 Instance 的 imports/personal-assets.xlsx；旧布局仍为 data/imports。
AI_CENTER_ASSET_WORKBOOK=

# 可选 TypeSafe / Jev 质量层。只写未提交的 .env。缺 Key、关闭或 API 失败时问答继续。
# 先验默认 shadow：只预测并写 Trace，不裁剪 Tool、不改主模型提示。
# AI_CENTER_TYPESAFE_API_KEY=
# TYPESAFE_API_KEY=
# AI_CENTER_JEV_DISABLED=1
# AI_CENTER_JEV_PRIOR=shadow
# AI_CENTER_JEV_REVIEWER=on
# Evidence Gate：检索结果进模型前打相关 / 证据 / 来源质量分。默认 enforce；失败则放行，不阻断问答。
# AI_CENTER_JEV_EVIDENCE_GATE=enforce
# AI_CENTER_JEV_TIMEOUT_MS=10000
# AI_CENTER_JEV_MODEL=jev-latest
# Feed 信息筛选层。与 AI_CENTER_JEV_DISABLED 独立；默认 shadow，确认后再开 enforce。
# AI_CENTER_FEED_FILTER=shadow
# AI_CENTER_FEED_FILTER_VERSION=feed-filter-v1
