AI_CENTER_HOST=0.0.0.0
# Launcher 未显式传 -Port 时，同样遵循 Process → Instance .env → Repository .env → 8787。
AI_CENTER_PORT=8787
# 单实例默认继续使用仓库内旧布局。设置 INSTANCE_DIR 后，默认改用该目录下的
# data / knowledge / config / imports / runtime；字段级旧变量仍可单独覆盖。
AI_CENTER_INSTANCE_ID=local
AI_CENTER_INSTANCE_DIR=
AI_CENTER_DATA_DIR=
AI_CENTER_KNOWLEDGE_DIR=
AI_CENTER_PAIRING_TTL_MINUTES=10
# 可选：实例共享账号，作为扫码配对之外的登录入口。两者都填才启用。
# 只写入未提交的 .env，不要提交真实密码。登录后仍签发设备 token，不会变成桌面管理员。
# AI_CENTER_LOGIN_USERNAME=
# AI_CENTER_LOGIN_PASSWORD=
AI_CENTER_WORKER_POLL_MS=1000
AI_CENTER_WORKER_LEASE_MS=600000

# 可选公网 HTTPS 入口。只有完成 docs/public-access-security.md 的 Tunnel 配置后再填写。
AI_CENTER_PUBLIC_URL=
AI_CENTER_PUBLIC_PAIRING_TTL_MINUTES=2

# 外部机器人只读令牌。默认每个令牌每分钟 60 次；访问日志保留 14 天。明文不写入 .env。
# AI_CENTER_API_TOKEN_RATE_PER_MINUTE=60
# AI_CENTER_API_TOKEN_LOG_RETENTION_DAYS=14

# 旧仓适配器只从环境读取位置，不在代码里写死机器路径。
AI_CENTER_SKILLS_ROOT=

# 浏览器采集。仓库随附 Windows CLI：externaltools/bsk.exe；也可显式配置其他路径。启动器会拉起 bsk daemon。
# 采集 Chrome 不是 CDP。扩展连上 daemon 后，Worker 用 bsk session 访问已登录页面。
# AI_CENTER_BROWSER_ID 是 BrowserSkill 实例 id，不是 Chrome 用户目录。
# AI_BROWSER_PROVIDER=bsk
# AI_BSK_PATH=externaltools/bsk.exe
AI_CENTER_BROWSER_ID=
# 扩展没连上、且这个用户目录的 Chrome 没在跑时，启动器才拉起它。默认是仓库 .ai-data\chrome-profile。
# 若登录态在日常 Chrome，把用户目录指到那份 Profile，不要另开一个空目录。
# AI_CENTER_SCRAPE_CHROME=
# AI_CENTER_SCRAPE_CHROME_USER_DATA=
# AI_CENTER_SCRAPE_CHROME_PROFILE_DIRECTORY=
# AI_CENTER_SCRAPE_BROWSER_MISS_LIMIT=3
# AI_CENTER_SCRAPE_BROWSER_CHECK_SECONDS=60

# 沪深 / 港股通 / B 股现价优先雪球匿名行情；可选登录 Cookie 只写入未提交的 .env。
# 不要把 Cookie 提交进 Git，也不要配给手机端。
XUEQIU_COOKIE=
# 同花顺金融 API（Hithink / fuyao）仅作雪球缺票回退。未配置时再回退 Yahoo。
# 与 AI-Hub 相同：HITHINK_FINANCE_API_KEY。
HITHINK_FINANCE_API_KEY=
# 默认 https://fuyao.aicubes.cn ；本机代理可改 AI_CENTER_FINANCE_BASE_URL。
AI_CENTER_FINANCE_BASE_URL=

# 日报窗口。默认北京时间 08:00 截止，统计前一日同一时刻到当日该时刻。
AI_CENTER_DAILY_TIMEZONE=Asia/Shanghai
AI_CENTER_DAILY_CUTOFF=08:00

# Tushare Pro。网站登录后在个人中心复制 Token，不是账号密码。真实 token 只写入未提交的 .env。
TUSHARE_TOKEN=

# Elucid Grok Key：Codex / Harness，以及 Gemini 配额受限时的翻译与打标回退。
ELUCID_GROK_API_KEY=
# Codex 模型 grok-4.7，入口 https://hk.getelucid.com/v1

# Google AI Studio Gemini（信息流翻译专用）。
# 在 https://aistudio.google.com/apikey 创建 Key，按官方 JS 文档写入 GEMINI_API_KEY。
# https://aistudio.google.com/docs/get-started?codelanguage=javascript
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# AI_CENTER_GEMINI_MODEL=gemini-3.1-flash-lite

# Ask / 文章阅读只走 Harness LLM：deepseek-official 或 elucid-grok。不再用 AI_CENTER_AGENT_PROVIDER。
# 主循环、web_search / web_fetch、本地回退和结构整理共用这一套。
# elucid-grok 时 web_search 走 Grok 原生搜索；web_fetch 仍是 HTTP，不加 web_read。
AI_CENTER_HARNESS_PROVIDER=elucid-grok
ELUCID_GROK_API_KEY=
# AI_CENTER_ELUCID_GROK_API_ROOT=https://hk.getelucid.com/v1
# AI_CENTER_HARNESS_MODEL=grok-4.7
# 小时提炼/整小时编辑固定经现有 Harness 使用 Elucid；可独立覆盖模型。
# AI_CENTER_HARNESS_HOURLY_MODEL=grok-4.7
# AI_CENTER_HARNESS_RESEARCH_MODEL=
# AI_CENTER_ELUCID_GROK_TIMEOUT_MS=90000

# DeepSeek 官方路由。切到 AI_CENTER_HARNESS_PROVIDER=deepseek-official 时用。
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# DeepSeek Native Search 只留给本地循环回退的 search.web，生产 Ask 不注册。
# DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1
# DEEPSEEK_SEARCH_MODEL=deepseek-v4-flash

# 翻译 / 打标：Gemini 429 / RESOURCE_EXHAUSTED 后回退 Elucid Grok。
# 复用 ELUCID_GROK_API_KEY 与 AI_CENTER_ELUCID_GROK_API_ROOT；不再使用 DeepL / Google 翻译。
# 独立于 Ask 的 Harness 模型，缺省 grok-4.7。
# AI_CENTER_FEED_GROK_MODEL=grok-4.7

# 个人资产分析工作簿。默认读取当前 Instance 的 imports/personal-assets.xlsx；旧布局仍为 data/imports。
AI_CENTER_ASSET_WORKBOOK=

# 可选 TypeSafe / Jev 质量层。只写未提交的 .env。缺 Key、关闭或 API 失败时问答继续。
# 先验默认 shadow：只预测并写 Trace，不裁剪 Tool、不改主模型提示。
# AI_CENTER_TYPESAFE_API_KEY=
# TYPESAFE_API_KEY=
# AI_CENTER_JEV_DISABLED=1
# AI_CENTER_JEV_PRIOR=shadow
# AI_CENTER_JEV_REVIEWER=on
# Evidence Gate：检索结果进模型前打相关 / 证据 / 来源质量分。默认 enforce；失败则放行，不阻断问答。
# AI_CENTER_JEV_EVIDENCE_GATE=enforce
# Evidence Gate 两阶段合计上限；超时按失败放行原始检索结果，避免 Tool Result 长时间卡住。
# AI_CENTER_JEV_EVIDENCE_TIMEOUT_MS=15000
# AI_CENTER_JEV_TIMEOUT_MS=10000
# AI_CENTER_JEV_MODEL=jev-latest

# Ask / 文章阅读执行器默认是冻结的 DeepSeek Harness（dsh-base 0.1.6-alpha.2）。
# 公开互联网是 Harness 内置 web_search / web_fetch，不要为此创建 Domain web.search。
# 本地自研循环只留给测试注入 fake LLM，或显式回退（才会创建 search.web / Domain web.search / 豆包 sidecar）：
# AI_CENTER_AGENT_RUNTIME=local
# 未设置 TOOL_IDS 时开放当前可见的全部 Domain Tool；可再收窄。
# AI_CENTER_HARNESS_TOOL_IDS=holdings.rank,holdings.get
# Feed 信息筛选层。与 AI_CENTER_JEV_DISABLED 独立；默认 shadow，确认后再开 enforce。
# AI_CENTER_FEED_FILTER=shadow
# AI_CENTER_FEED_FILTER_VERSION=feed-value-v3.0
# V3 保存价值不使用主题/Tag；校准文件属于本机 runtime/feed-value-calibration.json。
# AI_CENTER_FEED_FILTER_RULE=all-three-0.60
# 三项正向分数全部 >=0.60 才入 ContentItem；enforce 下待定/技术失败也不放行，Capture 留底。
# calibrated-value 可回放旧 V3 校准规则；显式 feed-filter-v1 可兼容旧部署。

# 模型用量账本：显式版本费率（每百万 token），格式见 docs/model-usage-v1.md。
# 未配置或用量不完整时费用未知，不补零；不会触发余额轮询或模型调用。
AI_CENTER_MODEL_USAGE_RATES_JSON=[]

# 单一信息加工开关。默认legacy；tree-v3需先隔离验收，切换后替代旧小时与日报加工。
AI_CENTER_INFORMATION_PIPELINE=legacy

# 单篇文章整理：同一 Harness；默认不启用。正常一次产出中文标题/Tag/摘要/正文。
# AI_CENTER_ARTICLE_NORMALIZE=1
# AI_CENTER_HARNESS_ARTICLE_PROVIDER=google
# AI_CENTER_HARNESS_ARTICLE_MODEL=gemini-3.1-flash-lite
# Host-only request model allowlist (comma separated); default model is always allowed.
# AI_CENTER_GEMINI_ARTICLE_MODELS=gemini-3.1-flash-lite
# Main article pool: alternate eligible models before sending the original once.
# AI_CENTER_GEMINI_ARTICLE_MODEL_POOL=gemini-3.1-flash-lite,gemini-3.5-flash-lite
# AI_CENTER_HARNESS_ARTICLE_FALLBACK=elucid-grok
# AI_CENTER_HARNESS_ARTICLE_FALLBACK_MODEL=grok-4.7
# GEMINI_API_KEY2=
# GEMINI_API_KEY3=
# GEMINI_API_KEY4=
# GEMINI_API_KEY5=
# 五个独立账号模式：每账号RPM20/RPD500，全池RPD2500；Google太平洋午夜重置。
# AI_CENTER_GEMINI_ARTICLE_POOL_CONCURRENCY=5
# AI_CENTER_GEMINI_ARTICLE_REQUESTS_PER_DAY=2500
# AI_CENTER_GEMINI_ARTICLE_KEY_REQUESTS_PER_DAY=500
# 启用五账号模式时将下方旧值改为：全部五Key、MIN_INTERVAL_MS=3000、RPM=20、HOUR=2500。
# 项目标识只需稳定的本地别名。同项目填相同值；未确认时共享流量预算、按 Key 冷却。
# GEMINI_API_KEY_PROJECT=shared
# GEMINI_API_KEY2_PROJECT=shared
# GEMINI_API_KEY3_PROJECT=shared
# AI_CENTER_GEMINI_KEY_ENVS=GEMINI_API_KEY,GEMINI_API_KEY2,GEMINI_API_KEY3
# AI_CENTER_GEMINI_ARTICLE_MIN_INTERVAL_MS=10000
# AI_CENTER_GEMINI_ARTICLE_REQUESTS_PER_MINUTE=6
# AI_CENTER_GEMINI_ARTICLE_REQUESTS_PER_HOUR=60
# AI_CENTER_GEMINI_ARTICLE_ESTIMATED_TOKENS_PER_MINUTE=100000
# 长音频转写按每分钟 token 切段。未填 PROJECT 的密钥各自一份额度；同一个 PROJECT 共用一份。
# AI_CENTER_AUDIO_TRANSCRIBE_TOKENS_PER_MINUTE=20000
# AI_CENTER_AUDIO_TRANSCRIBE_TOKENS_PER_SECOND=32
# 日报生成时间单独推迟到半点；统计截止时间保持 AI_CENTER_DAILY_CUTOFF。
# AI_CENTER_DAILY_RUN_MINUTE=30

# 原文全文翻译仅使用 Gemma，不回退到 Flash/Grok 等模型。
# AI_CENTER_GEMMA_TRANSLATION_MODELS=gemma-4-31b-it,gemma-4-26b-a4b-it
# AI_CENTER_GEMMA_TRANSLATION_KEY_ENV=GEMINI_API_KEY5
# Pool overrides the legacy single-key selector; unavailable/duplicate keys are skipped.
# AI_CENTER_GEMMA_TRANSLATION_KEY_ENVS=GEMINI_API_KEY,GEMINI_API_KEY2,GEMINI_API_KEY3,GEMINI_API_KEY4,GEMINI_API_KEY5
# AI_CENTER_WORKER_TRANSLATION_CONCURRENCY=5
# Optional closed hourly condensation through the existing Google Harness.
# Independent from article normalization and daily analysis; no paid fallback.
AI_CENTER_HARNESS_HOURLY_PROVIDER=elucid-grok
# Set to gemini-3.1-flash-lite when HOURLY_PROVIDER=google.
# AI_CENTER_HARNESS_HOURLY_MODEL=gemini-3.1-flash-lite
# AI_CENTER_HARNESS_HOURLY_MAX_TOKENS=4096
# Ordered fallback. The next model is used only when every configured key is cooled
# or out of quota for the earlier model. Quota stays per key and model.
# The id used in this repo is gemini-3.1-flash-lite. Confirm any later id with the provider.
# AI_CENTER_GEMINI_HOURLY_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
# AI_CENTER_GEMINI_HOURLY_MODEL_POOL=gemini-3.1-flash-lite
# Cooled key+model pairs get one real generateContent probe (maxOutputTokens=1).
# Success clears the cooldown early. Daily-quota cooldowns use the slower interval.
# AI_CENTER_GEMINI_QUOTA_PROBE_MS=720000
# AI_CENTER_GEMINI_QUOTA_PROBE_DAILY_MS=1800000
# AI_CENTER_GEMINI_KEY_IDLE_MS=1800000
# AI_CENTER_GEMINI_QUOTA_PROBE=0
# Hourly reading classification batch size. 10 is the default. 1 keeps one item per call.
# Unclassified items in the same hour pool across arrivals until a full batch.
# A short remainder is sent only after that hour is no longer waiting on new information nodes.
# The batch prompt keeps READING_CLASS_INSTRUCTION and asks for one JSON object per idx.
# A parse gap falls back to the missing items only. Quota or cooldown does not split the batch.
# Google keys are round-robin and still use the hourly per-key admission.
# Each call waits up to 180s. A non-quota error is tried once on the next key, then deferred.
# AI_CENTER_READING_CLASS_BATCH=10

# 股民讨论日摘。独立于日报/小时报，默认北京时间 21:30。设为 0 关闭定时。
# 讨论区帖子 type=11、sort=time、每页 20。MAX_PAGES 最大 50，到上限会标明帖子可能未抓全。
# 评论优先 /statuses/v3/comments.json，按 max_id 翻页；只拉每只股票回复最多的前 N 帖。
# 主题 JSON：[{ "id": "memory", "name": "存储", "keywords": ["存储"], "symbols": ["SH603986"] }]
# AI_CENTER_INVESTOR_DIGEST=1
# AI_CENTER_INVESTOR_DIGEST_AT=21:30
# AI_CENTER_INVESTOR_DIGEST_TIMEZONE=Asia/Shanghai
# AI_CENTER_INVESTOR_DIGEST_MODEL=gemini-3.1-flash-lite
# AI_CENTER_INVESTOR_DIGEST_INTERVAL_MS=2500
# AI_CENTER_INVESTOR_DIGEST_INTERVAL_JITTER_MS=500
# AI_CENTER_BROWSER_LOCK_MS=900000
# AI_CENTER_INVESTOR_DIGEST_RETRIES=2
# AI_CENTER_INVESTOR_DIGEST_MAX_PAGES=8
# AI_CENTER_INVESTOR_DIGEST_MAX_COMMENT_PAGES=5
# AI_CENTER_INVESTOR_DIGEST_COMMENT_POSTS=15
# AI_CENTER_INVESTOR_DIGEST_THEMES=
